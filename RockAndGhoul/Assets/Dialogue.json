{
    "scenes": [
        {
            "script": [
                {
                    "speakerID": 0,
                    "line": "Jam Out SG! We made it! We're gonna rock their socks off. Or whatever they say."
                },
                {
                    "speakerID": 1,
                    "line": "Record deal, here we come."
                },
                {
                    "speakerID": 6,
                    "line": "Crazy bummer that so many acts forfeited! I wouldn't be surprised if they pit US against each other for content."
                },
                {
                    "speakerID": 1,
                    "line": "I'd like to see them try. (SMIRK)"
                },
                {
                    "speakerID": 1,
                    "line": "Yeah, we're so winning this thing. 'Kay, I need to pee. See ya, Rock-Star."
                },
                {
                    "speakerID": 5,
                    "line": "Spooky..."
                },
                {
                    "speakerID": 2,
                    "line": "Groooowl..."
                },
                {
                    "speakerID": 4,
                    "line": "MEGA SPOOKY!"
                },
                {
                    "speakerID": 4,
                    "line": "I gotta find Ghoul, and fast!"
                },
                {
                    "speakerID": 5,
                    "line": "But first, I gotta fight off...whatever these are..."
                },
                {
                    "speakerID": 4,
                    "line": "I get the feeling they won't let me get past if I don't do something about these creeps..."
                },
                {
                    "speakerID": 3,
                    "line": "Alright then, foul spirits! BRING IT ON!!!"
                }
            ],
            "textSpeed": 60.0,
