        {
          "script": [
                {
                    "speakerID": 6,
                    "line": "Phew! That took a while to get through."
                },
                {
                    "speakerID": 0,
                    "line": "Ghoul said she went to the toilet, so it should be this way."
                },
                {
                    "speakerID": 2,
                    "line": "Grooooooowl... Hissssss..."
                },
                {
                    "speakerID": 4,
                    "line": "WOW!"
                },
                {
                    "speakerID": 5,
                    "line": "Wait a minute, something seems off about these spirits?"
                },
                {
                    "speakerID": 2,
                    "line": "Ziiing..."
                },
                {
                    "speakerID": 5,
                    "line": "They have elemental barriers now?!?!"
                },
                {
                    "speakerID": 5,
                    "line": "Ugh great, just as I thought everything was going a little too easy."
                },
                {
                    "speakerID": 3,
                    "line": "Alright spirit, game on!"
                }
          ],
